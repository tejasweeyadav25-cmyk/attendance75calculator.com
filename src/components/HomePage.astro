---
import Layout from '../layouts/Layout.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getTranslations } from '../i18n';
import { locales, localePrefix, defaultLocale } from '../i18n/locales';

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const siteUrl = 'https://attendance75calculator.com';
const canonicalUrl = `${siteUrl}${localePrefix(lang)}/`;
const currentLocale = locales.find((l) => l.code === lang) ?? locales[0];

const alternates = [
	...locales.map((l) => ({
		hreflang: l.hreflang,
		href: `${siteUrl}${localePrefix(l.code)}/`,
	})),
	{ hreflang: 'x-default', href: `${siteUrl}/` },
];

const footerNote = t.footer.note.replace('{year}', String(new Date().getFullYear()));

// Strings consumed by the client-side calculator script (translated + interpolation-ready)
const jsStrings = { ...t.js, heldSuffix: t.results.heldSuffix };
const jsStringsJson = JSON.stringify(jsStrings).replace(/</g, '\\u003c');

// JSON-LD Structured Data for WebApplication
const webAppSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'Attendance Calculator',
	alternateName: [
		'75 Attendance Calculator',
		'College Attendance Calculator',
		'Attendance Calculator 75',
		'75 Percent Attendance Calculator',
		'Student Attendance Calculator',
		'Attendance Calculator App',
	],
	url: canonicalUrl,
	inLanguage: lang,
	description: t.meta.description,
	applicationCategory: 'EducationalApplication',
	operatingSystem: 'All',
	browserRequirements: 'Requires JavaScript. Requires HTML5.',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
	featureList: [
		'Instant 75% college attendance calculation',
		'Monthly and semester attendance tracking',
		'Safe bunk limit calculation',
		'Consecutive classes needed for recovery',
		'Support for 100%, 80%, 75%, and custom targets',
		'Dark mode support',
		'100% private and client-side processing',
	],
};

// JSON-LD Structured Data for Organization (helps Google surface the site logo in search results)
const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	url: siteUrl,
	logo: `${siteUrl}/apple-touch-icon.png`,
};

// JSON-LD Structured Data for FAQPage
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	inLanguage: lang,
	mainEntity: t.article.faq.items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answerHtml.replace(/<[^>]+>/g, ''),
		},
	})),
};
---

<Layout
	title={t.meta.title}
	description={t.meta.description}
	keywords={t.meta.keywords}
	canonicalUrl={canonicalUrl}
	lang={lang}
	ogLocale={currentLocale.ogLocale}
	alternates={alternates}
>
	<Fragment slot="head-extra">
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</Fragment>

	<div class="page-container">
		<div class="content-wrapper">
			<!-- Top Bar with Brand Badge, Language Switcher & Theme Toggle -->
			<nav class="top-nav">
				<div class="inline-badge">
					<span class="badge-dot"></span>
					<span class="badge-text">{t.nav.badge}</span>
				</div>

				<div class="top-nav-right">
					<LangSwitcher lang={lang} />

					<!-- Theme Toggle Button -->
					<button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label={t.nav.themeToggleAria} title={t.nav.themeToggleAria}>
						<span id="theme-icon" class="theme-icon">🌙</span>
						<span id="theme-label" class="theme-label">{t.nav.themeDark}</span>
					</button>
				</div>
			</nav>

			<!-- Header -->
			<header class="text-center mb-6">
				<h1 class="page-title">
					{t.header.title}
				</h1>
				<p class="page-subtitle" set:html={t.header.subtitleHtml} />

				<!-- Quick Links -->
				<nav class="hero-links">
					<a href="/about-us" class="hero-link">{t.nav.aboutUs}</a>
					<a href="/privacy-policy" class="hero-link">{t.nav.privacyPolicy}</a>
					<a href="/terms-and-conditions" class="hero-link">{t.nav.termsAndConditions}</a>
					<a href="/contact-us" class="hero-link">{t.nav.contactUs}</a>
				</nav>
			</header>

			<!-- Main Calculator Card -->
			<main class="calculator-card">
				<div class="calculator-inner-grid">
					<!-- Left Column: Inputs -->
					<div class="calculator-left">
						<!-- 1. Target Percentage Selector -->
						<div class="form-group mb-5">
							<div class="flex-between mb-2">
								<label class="field-label">{t.calculator.targetLabel}</label>
								<span class="target-indicator" id="target-indicator">{t.calculator.targetPrefix} 75%</span>
							</div>
							<div class="pills-grid" id="target-pills">
								<button type="button" class="target-btn" data-value="60">60%</button>
								<button type="button" class="target-btn" data-value="65">65%</button>
								<button type="button" class="target-btn" data-value="70">70%</button>
								<button type="button" class="target-btn active" data-value="75">75%</button>
								<button type="button" class="target-btn" data-value="80">80%</button>
								<button type="button" class="target-btn" data-value="85">85%</button>
								<button type="button" class="target-btn" data-value="90">90%</button>
								<div class="custom-target-wrap">
									<input
										type="number"
										id="custom-target"
										min="1"
										max="100"
										placeholder={t.calculator.customPlaceholder}
										class="custom-target-input"
										aria-label={t.calculator.customPlaceholder}
									/>
									<span class="custom-target-unit">%</span>
								</div>
							</div>
						</div>

						<!-- 2. Inputs Grid (Attended, Total Held, Total in Semester) -->
						<div class="inputs-grid mb-6">
							<div class="input-block">
								<label for="classes-attended" class="field-label">
									{t.calculator.attendedLabel} <span class="label-muted">{t.calculator.attendedSub}</span>
								</label>
								<input
									type="number"
									id="classes-attended"
									min="0"
									placeholder={t.calculator.attendedPlaceholder}
									class="text-input"
								/>
							</div>

							<div class="input-block">
								<label for="total-classes" class="field-label">
									{t.calculator.totalLabel} <span class="label-muted">{t.calculator.totalSub}</span>
								</label>
								<input
									type="number"
									id="total-classes"
									min="0"
									placeholder={t.calculator.totalPlaceholder}
									class="text-input"
								/>
							</div>

							<div class="input-block full-width-sm">
								<label for="total-semester-classes" class="field-label">
									{t.calculator.semTotalLabel} <span class="label-optional">{t.calculator.semTotalSub}</span>
								</label>
								<input
									type="number"
									id="total-semester-classes"
									min="0"
									placeholder={t.calculator.semTotalPlaceholder}
									class="text-input"
								/>
							</div>
						</div>
					</div>

					<!-- Right Column: Results -->
					<div class="calculator-right">
						<!-- 3. Dynamic Results Box -->
						<div id="results-box" class="results-box">
					<!-- Header Status & Percentage -->
					<div class="results-header">
						<div>
							<span class="result-eyebrow">{t.results.currentAttendanceEyebrow}</span>
							<div class="percentage-row">
						<span id="percentage-display" class="percentage-val">0.0%</span>
							<span id="ratio-display" class="ratio-val">(0 / 0 {t.results.heldSuffix})</span>
							</div>
						</div>
						<div id="status-badge" class="status-badge status-warning">
							{t.js.noDataStatus}
						</div>
					</div>

					<!-- Progress Bar with Target Marker -->
					<div class="progress-track">
						<div id="progress-bar" class="progress-fill" style="width: 0%;"></div>
						<div id="target-marker" class="target-marker" style="left: 75%;" title={`${t.calculator.targetPrefix} 75%`}></div>
					</div>

					<!-- Vibe Check / Primary Slang Message Box -->
					<div id="vibe-box" class="vibe-box vibe-warning">
						<p id="vibe-message" class="vibe-message">
							{t.js.noDataVibe}
						</p>
					</div>

					<!-- Split Details: Right Now vs. End-of-Semester -->
					<div class="details-grid">
						<!-- Immediate To-Date Card -->
						<div class="detail-card">
							<span class="detail-eyebrow">{t.results.rightNowEyebrow}</span>
							<h3 id="current-headline" class="detail-headline">{t.results.waitingHeadline}</h3>
							<p id="current-desc" class="detail-desc">
								{t.results.waitingDesc}
							</p>
						</div>

						<!-- End of Semester Forecast Card -->
						<div id="sem-forecast-card" class="detail-card hidden">
							<span class="detail-eyebrow">{t.results.semesterForecastEyebrow}</span>
							<h3 id="sem-headline" class="detail-headline"></h3>
							<p id="sem-desc" class="detail-desc">
							</p>
						</div>
					</div>

						<!-- Quick Copy Status Button -->
						<div class="mt-4">
							<button type="button" id="copy-summary-btn" class="btn-copy">
								<span id="copy-icon">📋</span>
								<span id="copy-btn-text">{t.results.copyButtonText}</span>
							</button>
						</div>
					</div>
				</div>
			</div>
			</main>

			<!-- Comprehensive SEO Guide & Information Section -->
			<article class="seo-article">
				<!-- Section 1: Overview -->
				<section class="seo-section">
					<h2 class="seo-h2">{t.article.overview.h2}</h2>
					<p set:html={t.article.overview.p1Html} />
					<p set:html={t.article.overview.p2Html} />
				</section>

				<!-- Section 2: Why 75% Attendance is Mandatory -->
				<section class="seo-section">
					<h2 class="seo-h2">{t.article.why75.h2}</h2>
					<p>{t.article.why75.p1}</p>
					<p>{t.article.why75.p2}</p>
					<ul class="seo-list">
						{t.article.why75.list.map((item) => <li set:html={item} />)}
					</ul>
					<p set:html={t.article.why75.p3Html} />
				</section>

				<!-- Section 3: The Mathematical Formulas -->
				<section class="seo-section">
					<h2 class="seo-h2">{t.article.formulas.h2}</h2>
					<p set:html={t.article.formulas.introHtml} />

					{t.article.formulas.cards.map((card) => (
						<div class="formula-card">
							<h3 class="formula-title">{card.title}</h3>
							<p class="formula-text">
								<code>{card.formula}</code>
							</p>
							<p class="formula-desc" set:html={card.descHtml} />
						</div>
					))}
				</section>

				<!-- Section 4: Step-by-Step User Guide -->
				<section class="seo-section">
					<h2 class="seo-h2">{t.article.howTo.h2}</h2>
					<p set:html={t.article.howTo.introHtml} />
					<ol class="seo-ordered-list">
						{t.article.howTo.steps.map((step) => <li set:html={step} />)}
					</ol>
				</section>

				<!-- Section 5: Key Features -->
				<section class="seo-section">
					<h2 class="seo-h2">{t.article.features.h2}</h2>
					<div class="features-seo-grid">
						{t.article.features.items.map((item) => (
							<div class="feature-seo-item">
								<h3 class="feature-seo-title">{item.icon} {item.title}</h3>
								<p>{item.desc}</p>
							</div>
						))}
					</div>
				</section>

				<!-- Section 6: Frequently Asked Questions (FAQ) -->
				<section class="seo-section">
					<h2 class="seo-h2">{t.article.faq.h2}</h2>
					<div class="faq-container">
						{t.article.faq.items.map((item, i) => (
							<details class="faq-item" open={i === 0}>
								<summary class="faq-question">{item.question}</summary>
								<div class="faq-answer">
									<p set:html={item.answerHtml} />
								</div>
							</details>
						))}
					</div>
				</section>
			</article>

			<!-- Footer -->
			<footer class="footer text-center">
				<nav class="footer-nav">
					<a href="/about-us" class="footer-link">{t.nav.aboutUs}</a>
					<span class="footer-separator">•</span>
					<a href="/privacy-policy" class="footer-link">{t.nav.privacyPolicy}</a>
					<span class="footer-separator">•</span>
					<a href="/terms-and-conditions" class="footer-link">{t.nav.termsAndConditions}</a>
					<span class="footer-separator">•</span>
					<a href="/contact-us" class="footer-link">{t.nav.contactUs}</a>
				</nav>
				<p class="footer-note">
					{footerNote}
				</p>
			</footer>
		</div>
	</div>

	<!-- Toast Notification -->
	<div id="toast" class="toast hidden">
		✓ {t.results.toastText}
	</div>

	<!-- Translated strings for the client-side calculator script -->
	<script type="application/json" id="i18n-js-strings" set:html={jsStringsJson} />
</Layout>

<style>
	/* CSS Variables for Light & Dark Theme */
	:root {
		--bg-canvas: #fafafa;
		--bg-card: #ffffff;
		--bg-input: #ffffff;
		--bg-subtle: #fafafa;
		--bg-pill: #ffffff;
		--bg-pill-hover: #f2f2f2;
		--bg-pill-active: #171717;
		--text-pill-active: #ffffff;
		--text-ink: #171717;
		--text-body: #4d4d4d;
		--text-muted: #8f8f8f;
		--border-hairline: #ebebeb;
		--border-focus: #171717;
		--track-bg: #f2f2f2;
		--target-marker-bg: #171717;
		--shadow-card: 0 2px 8px rgba(0,0,0,0.04);
		--badge-target-bg: #d3e5ff;
		--badge-target-text: #0070f3;

		/* Vibe Colors Light */
		--vibe-safe-bg: #f4fbf6;
		--vibe-safe-border: #c7eed2;
		--vibe-safe-text: #00703c;
		--vibe-warn-bg: #fffdf5;
		--vibe-warn-border: #fde8b3;
		--vibe-warn-text: #ab570a;
		--vibe-danger-bg: #fff8f8;
		--vibe-danger-border: #fcd5d5;
		--vibe-danger-text: #ee0000;
		--vibe-cooked-bg: #171717;
		--vibe-cooked-border: #000000;
		--vibe-cooked-text: #ffffff;

		/* SEO Article Light */
		--code-bg: #f3f3f3;
		--code-border: #e5e5e5;
	}

	html.dark {
		--bg-canvas: #0a0a0a;
		--bg-card: #121212;
		--bg-input: #1a1a1a;
		--bg-subtle: #171717;
		--bg-pill: #1a1a1a;
		--bg-pill-hover: #262626;
		--bg-pill-active: #ffffff;
		--text-pill-active: #000000;
		--text-ink: #ededed;
		--text-body: #a1a1a1;
		--text-muted: #707070;
		--border-hairline: #262626;
		--border-focus: #ffffff;
		--track-bg: #262626;
		--target-marker-bg: #ffffff;
		--shadow-card: 0 4px 20px rgba(0,0,0,0.3);
		--badge-target-bg: #072a5a;
		--badge-target-text: #52a8ff;

		/* Vibe Colors Dark */
		--vibe-safe-bg: #0b2214;
		--vibe-safe-border: #164e29;
		--vibe-safe-text: #4ade80;
		--vibe-warn-bg: #291a03;
		--vibe-warn-border: #593907;
		--vibe-warn-text: #fbbf24;
		--vibe-danger-bg: #2b0b0b;
		--vibe-danger-border: #5c1818;
		--vibe-danger-text: #f87171;
		--vibe-cooked-bg: #000000;
		--vibe-cooked-border: #404040;
		--vibe-cooked-text: #ffffff;

		/* SEO Article Dark */
		--code-bg: #1c1c1c;
		--code-border: #2a2a2a;
	}

	/* Layout & Base */
	.page-container {
		min-height: 100vh;
		background-color: var(--bg-canvas);
		color: var(--text-ink);
		display: flex;
		justify-content: center;
		padding: 28px 16px;
		font-family: 'Geist', Arial, sans-serif;
		box-sizing: border-box;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.content-wrapper {
		width: 100%;
		max-width: 640px;
		display: flex;
		flex-direction: column;
	}

	/* Desktop: wider container and better spacing */
	@media (min-width: 1024px) {
		.content-wrapper {
			max-width: 1200px;
		}

		.page-container {
			padding: 40px 24px;
		}

		.calculator-card {
			padding: 40px;
		}
	}

	/* Top Nav Bar with Theme Toggle */
	.top-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20px;
	}

	.top-nav-right {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.inline-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		font-size: 12px;
		font-weight: 500;
		color: var(--text-body);
		box-shadow: 0 1px 2px rgba(0,0,0,0.03);
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background-color: #00c851;
		border-radius: 50%;
	}

	/* Theme Toggle Button */
	.theme-toggle-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		font-size: 12px;
		font-weight: 500;
		color: var(--text-ink);
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}

	.theme-toggle-btn:hover {
		background: var(--bg-pill-hover);
		border-color: var(--text-muted);
	}

	.theme-icon {
		font-size: 14px;
		line-height: 1;
	}

	.theme-label {
		font-size: 12px;
		font-weight: 500;
	}

	/* Header */
	.page-title {
		font-size: 30px;
		font-weight: 700;
		color: var(--text-ink);
		margin: 6px 0;
		letter-spacing: -0.8px;
		line-height: 1.2;
	}

	.page-subtitle {
		font-size: 14px;
		color: var(--text-body);
		line-height: 1.5;
		margin: 0 auto 16px auto;
		max-width: 520px;
	}

	.hero-links {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 16px;
	}

	.hero-link {
		font-size: 13px;
		font-weight: 500;
		color: var(--text-body);
		text-decoration: none;
		padding: 6px 14px;
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		background: var(--bg-card);
		transition: all 0.15s ease;
	}

	.hero-link:hover {
		color: var(--text-ink);
		border-color: var(--border-focus);
		background: var(--bg-subtle);
	}

	/* Card */
	.calculator-card {
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 16px;
		padding: 28px;
		box-shadow: var(--shadow-card);
		margin-bottom: 24px;
		transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.field-label {
		display: block;
		font-size: 13px;
		font-weight: 600;
		color: var(--text-ink);
		margin-bottom: 6px;
	}

	.label-muted {
		font-weight: 400;
		color: var(--text-muted);
		font-size: 11px;
	}

	.label-optional {
		font-weight: 500;
		color: var(--badge-target-text);
		font-size: 11px;
	}

	.flex-between {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.target-indicator {
		font-size: 12px;
		font-weight: 600;
		color: var(--badge-target-text);
		background: var(--badge-target-bg);
		padding: 2px 8px;
		border-radius: 100px;
	}

	/* Target Pills Grid */
	.pills-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		align-items: center;
	}

	.target-btn {
		padding: 7px 14px;
		font-size: 13px;
		font-weight: 500;
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		background: var(--bg-pill);
		color: var(--text-body);
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}

	.target-btn:hover {
		background: var(--bg-pill-hover);
		color: var(--text-ink);
	}

	.target-btn.active {
		background: var(--bg-pill-active);
		color: var(--text-pill-active);
		border-color: var(--bg-pill-active);
		font-weight: 600;
	}

	.custom-target-wrap {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		background: var(--bg-input);
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		padding: 2px 10px;
	}

	.custom-target-input {
		width: 50px;
