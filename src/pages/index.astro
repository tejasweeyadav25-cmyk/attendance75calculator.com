---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Attendance Calculator - Free 75% College Attendance Calculator App"
	description="Free online attendance calculator to check 75% criteria. Calculate safe bunks, classes needed to reach 75 percent attendance, and semester projections instantly."
	keywords="attendance calculator, 75 attendance calculator, attendance calculator 75, attendance calculator app, 75 percent attendance calculator, college attendance calculator, attendance calculator college"
>
	<div class="page-container">
		<div class="content-wrapper">
			<!-- Top Bar with Brand Badge & Theme Toggle -->
			<nav class="top-nav">
				<div class="inline-badge">
					<span class="badge-dot"></span>
					<span class="badge-text">Attendance 75 Calculator</span>
				</div>

				<!-- Theme Toggle Button -->
				<button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Dark/Light Mode" title="Toggle Theme">
					<span id="theme-icon" class="theme-icon">🌙</span>
					<span id="theme-label" class="theme-label">Dark</span>
				</button>
			</nav>

			<!-- Header -->
			<header class="text-center mb-6">
				<h1 class="page-title">
					Attendance Calculator & 75% Bunk Planner
				</h1>
				<p class="page-subtitle">
					The smart <strong>75 attendance calculator</strong> for college students. Know your exact attendance percentage, calculate safe bunks, or plan your recovery.
				</p>
			</header>

			<!-- Main Calculator Card -->
			<main class="calculator-card">
				<!-- 1. Target Percentage Selector -->
				<div class="form-group mb-5">
					<div class="flex-between mb-2">
						<label class="field-label">Target Attendance Requirement</label>
						<span class="target-indicator" id="target-indicator">Target: 75%</span>
					</div>
					<div class="pills-grid" id="target-pills">
						<button type="button" class="target-btn" data-value="60">60%</button>
						<button type="button" class="target-btn" data-value="65">65%</button>
						<button type="button" class="target-btn" data-value="70">70%</button>
						<button type="button" class="target-btn active" data-value="75">75%</button>
						<button type="button" class="target-btn" data-value="80">80%</button>
						<button type="button" class="target-btn" data-value="85">85%</button>
						<button type="button" class="target-btn" data-value="90">90%</button>
						<div class="custom-target-wrap">
							<input
								type="number"
								id="custom-target"
								min="1"
								max="100"
								placeholder="Custom"
								class="custom-target-input"
								aria-label="Custom target attendance percentage"
							/>
							<span class="custom-target-unit">%</span>
						</div>
					</div>
				</div>

				<!-- 2. Inputs Grid (Attended, Total Held, Total in Semester) -->
				<div class="inputs-grid mb-6">
					<div class="input-block">
						<label for="classes-attended" class="field-label">
							Classes Attended <span class="label-muted">(Present)</span>
						</label>
						<input
							type="number"
							id="classes-attended"
							min="0"
							value="30"
							placeholder="e.g. 30"
							class="text-input"
						/>
					</div>

					<div class="input-block">
						<label for="total-classes" class="field-label">
							Total Classes Held <span class="label-muted">(To Date)</span>
						</label>
						<input
							type="number"
							id="total-classes"
							min="0"
							value="40"
							placeholder="e.g. 40"
							class="text-input"
						/>
					</div>

					<div class="input-block full-width-sm">
						<label for="total-semester-classes" class="field-label">
							Total Classes in Semester <span class="label-optional">(Optional)</span>
						</label>
						<input
							type="number"
							id="total-semester-classes"
							min="0"
							value="100"
							placeholder="e.g. 100 expected classes"
							class="text-input"
						/>
					</div>
				</div>

				<!-- 3. Dynamic Results Box -->
				<div id="results-box" class="results-box">
					<!-- Header Status & Percentage -->
					<div class="results-header">
						<div>
							<span class="result-eyebrow">CURRENT ATTENDANCE</span>
							<div class="percentage-row">
								<span id="percentage-display" class="percentage-val">75.0%</span>
								<span id="ratio-display" class="ratio-val">(30 / 40 held)</span>
							</div>
						</div>
						<div id="status-badge" class="status-badge status-safe">
							Safe & Chilling
						</div>
					</div>

					<!-- Progress Bar with Target Marker -->
					<div class="progress-track">
						<div id="progress-bar" class="progress-fill" style="width: 75%;"></div>
						<div id="target-marker" class="target-marker" style="left: 75%;" title="Target: 75%"></div>
					</div>

					<!-- Vibe Check / Primary Slang Message Box -->
					<div id="vibe-box" class="vibe-box vibe-safe">
						<p id="vibe-message" class="vibe-message">
							You're safe to bunk! Go touch grass, grab some chai, and enjoy your free time. 🚀
						</p>
					</div>

					<!-- Split Details: Right Now vs. End-of-Semester -->
					<div class="details-grid">
						<!-- Immediate To-Date Card -->
						<div class="detail-card">
							<span class="detail-eyebrow">RIGHT NOW STATUS</span>
							<h3 id="current-headline" class="detail-headline">Safe to Bunk: 0 classes</h3>
							<p id="current-desc" class="detail-desc">
								You are exactly at 75%. Cannot miss any immediate classes without dropping.
							</p>
						</div>

						<!-- End of Semester Forecast Card -->
						<div id="sem-forecast-card" class="detail-card">
							<span class="detail-eyebrow">SEMESTER FORECAST</span>
							<h3 id="sem-headline" class="detail-headline">Semester Bunk Budget: 15 classes</h3>
							<p id="sem-desc" class="detail-desc">
								Out of 60 classes left, you only need to attend 45 to finish at 75%.
							</p>
						</div>
					</div>

					<!-- Quick Copy Status Button -->
					<div class="mt-4">
						<button type="button" id="copy-summary-btn" class="btn-copy">
							<span id="copy-icon">📋</span>
							<span id="copy-btn-text">Copy Attendance Vibe Check</span>
						</button>
					</div>
				</div>
			</main>

			<!-- Comprehensive SEO Guide & Information Section (800 - 1200 words) -->
			<article class="seo-article">
				<!-- Section 1: Overview -->
				<section class="seo-section">
					<h2 class="seo-h2">What is an Attendance Calculator and Why Do You Need It?</h2>
					<p>
						An <strong>attendance calculator</strong> is an essential academic utility designed to help students track, calculate, and manage their lecture attendance with mathematical accuracy. In universities and colleges worldwide, maintaining a minimum attendance percentage—most commonly <strong>75 percent attendance</strong>—is a mandatory requirement to appear for final semester examinations.
					</p>
					<p>
						Whether you want to calculate how many lectures you can safely skip, figure out how many consecutive classes you must attend to overcome an attendance shortage, or forecast your end-of-semester standing, this <strong>75 attendance calculator</strong> eliminates guesswork. Instead of doing complex mental arithmetic or relying on confusing spreadsheets, our <strong>attendance calculator app</strong> provides instant, real-time insights with just two numbers: the classes you have attended and the total classes held so far.
					</p>
				</section>

				<!-- Section 2: Why 75% Attendance is Mandatory -->
				<section class="seo-section">
					<h2 class="seo-h2">Why is 75% Attendance Mandatory in College?</h2>
					<p>
						Higher education regulatory bodies (such as the UGC, AICTE, Bar Council of India, Medical Council, and global university boards) enforce a strict 75% attendance rule. Colleges implement this rule to ensure consistent classroom engagement, practical laboratory participation, and academic discipline.
					</p>
					<p>
						Falling below the required threshold leads to serious academic repercussions:
					</p>
					<ul class="seo-list">
						<li><strong>Debarment from Examinations:</strong> Students with an attendance shortage below 75% are often disqualified from sitting for end-semester or final exams.</li>
						<li><strong>Condonation Fines & Penalties:</strong> While some colleges allow condonation for attendance between 65% and 75% with a medical certificate, it often involves hefty administrative fines.</li>
						<li><strong>Internal Assessment Loss:</strong> Many universities allocate 5 to 10 marks of internal assessment directly proportional to attendance percentage.</li>
						<li><strong>Year Back or Semester Detention:</strong> Severe shortages below 60% can result in semester detention, forcing students to repeat the entire academic term.</li>
					</ul>
					<p>
						Using a dedicated <strong>college attendance calculator</strong> allows you to stay ahead of attendance shortfalls before they become critical emergencies.
					</p>
				</section>

				<!-- Section 3: The Mathematical Formulas -->
				<section class="seo-section">
					<h2 class="seo-h2">How to Calculate 75% Attendance: Formulas & Logic</h2>
					<p>
						Our <strong>attendance calculator 75</strong> tool runs on precise mathematical algorithms. Here is the exact breakdown of how your attendance percentage, safe bunk limit, and catch-up requirements are computed:
					</p>

					<div class="formula-card">
						<h3 class="formula-title">1. Current Attendance Percentage Formula</h3>
						<p class="formula-text">
							<code>Attendance (%) = (Classes Attended / Total Classes Held) × 100</code>
						</p>
						<p class="formula-desc">
							<strong>Example:</strong> If 40 lectures have been held to date and you attended 30 of them:<br />
							<code>(30 / 40) × 100 = 75.0%</code>
						</p>
					</div>

					<div class="formula-card">
						<h3 class="formula-title">2. Safe Bunk Limit Formula (When Current % ≥ Target %)</h3>
						<p class="formula-text">
							<code>Safe Bunks = ⌊(Classes Attended / Target Fraction) - Total Classes Held⌋</code>
						</p>
						<p class="formula-desc">
							Where <em>Target Fraction</em> is <code>0.75</code> for 75%. The floor symbol <code>⌊ ⌋</code> rounds down to the nearest whole integer to ensure your percentage never dips below 75%.<br />
							<strong>Example:</strong> Attended = 36, Total Held = 40, Target = 75% (0.75):<br />
							<code>Safe Bunks = ⌊(36 / 0.75) - 40⌋ = ⌊48 - 40⌋ = 8 classes</code>.<br />
							You can safely miss the next 8 consecutive classes and still finish exactly at 75%.
						</p>
					</div>

					<div class="formula-card">
						<h3 class="formula-title">3. Consecutive Classes Needed to Recover (When Current % &lt; Target %)</h3>
						<p class="formula-text">
							<code>Classes to Attend = ⌈((Target Fraction × Total Classes Held) - Classes Attended) / (1 - Target Fraction)⌉</code>
						</p>
						<p class="formula-desc">
							For a 75% target (where <code>Target Fraction = 0.75</code>), the denominator is <code>1 - 0.75 = 0.25</code>. Multiplying by <code>4</code> simplifies the formula to:<br />
							<code>Classes to Attend = ⌈3 × Total Held - 4 × Attended⌉</code>.<br />
							<strong>Example:</strong> Attended = 20, Total Held = 35. To reach 75%:<br />
							<code>Classes to Attend = ⌈3(35) - 4(20)⌉ = ⌈105 - 80⌉ = 25 classes</code>.<br />
							You must attend the next 25 classes in a row without absence to regain 75% attendance.
						</p>
					</div>
				</section>

				<!-- Section 4: Step-by-Step User Guide -->
				<section class="seo-section">
					<h2 class="seo-h2">How to Use This 75 Percent Attendance Calculator App</h2>
					<p>
						Using our <strong>attendance calculator college</strong> utility is straightforward and requires zero registration or downloads:
					</p>
					<ol class="seo-ordered-list">
						<li><strong>Select Your Attendance Target:</strong> Click on one of the quick-select pills (60%, 65%, 70%, 75%, 80%, 85%, 90%) or type any custom percentage required by your department.</li>
						<li><strong>Enter Classes Attended:</strong> Input the total number of lecture or lab hours you have physically attended so far.</li>
						<li><strong>Enter Total Classes Held:</strong> Input the cumulative number of classes your professors have conducted to date.</li>
						<li><strong>(Optional) Enter Total Classes in Semester:</strong> If you know the total planned classes for the entire semester (e.g., 90 or 120 classes), enter it to unlock the <em>Semester Forecast</em> card.</li>
						<li><strong>Read Instant Results:</strong> Watch your percentage, safe bunk quota, recovery target, and dynamic vibe status update instantly as you type.</li>
					</ol>
				</section>

				<!-- Section 5: Key Features -->
				<section class="seo-section">
					<h2 class="seo-h2">Key Features of Our College Attendance Calculator</h2>
					<div class="features-seo-grid">
						<div class="feature-seo-item">
							<h3 class="feature-seo-title">⚡ Instant Real-Time Calculations</h3>
							<p>No waiting and no "Submit" buttons. The calculator updates every metric as soon as you type or change a number.</p>
						</div>
						<div class="feature-seo-item">
							<h3 class="feature-seo-title">🎯 End-of-Semester Forecast</h3>
							<p>Plan your bunk budget across the remaining semester. Find out if your target is mathematically achievable or if you are "cooked".</p>
						</div>
						<div class="feature-seo-item">
							<h3 class="feature-seo-title">🔒 100% Client-Side Privacy</h3>
							<p>All calculations happen directly inside your browser. No attendance data, login credentials, or student records are ever sent to external servers.</p>
						</div>
						<div class="feature-seo-item">
							<h3 class="feature-seo-title">🌙 Built-in Dark Mode</h3>
							<p>Seamlessly toggle between crisp light mode and deep OLED dark mode for late-night college study sessions.</p>
						</div>
					</div>
				</section>

				<!-- Section 6: Frequently Asked Questions (FAQ) -->
				<section class="seo-section">
					<h2 class="seo-h2">Frequently Asked Questions (FAQ)</h2>
					<div class="faq-container">
						<details class="faq-item" open>
							<summary class="faq-question">What is a Monthly Attendance Calculator and how to use it?</summary>
							<div class="faq-answer">
								<p>
									A <strong>monthly attendance calculator</strong> allows students and employees to calculate attendance percentage over a specific calendar month. Simply input the number of days or classes attended in that month and divide by the total working days or scheduled lectures held in that month, then multiply by 100.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">What is the Attendance Calculator Formula?</summary>
							<div class="faq-answer">
								<p>
									The basic <strong>attendance formula</strong> is: <code>Attendance (%) = (Classes Attended / Total Classes Held) × 100</code>. To find safe bunks above a target percentage (P%): <code>Safe Bunks = ⌊(Attended / (P/100)) - Total Held⌋</code>. To find classes needed to recover to target (P%): <code>Classes to Attend = ⌈((P/100 × Total Held) - Attended) / (1 - P/100)⌉</code>.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">What is the Attendance Calculator App and does it work offline?</summary>
							<div class="faq-answer">
								<p>
									The <strong>Attendance Calculator App</strong> is a free, web-based mobile-friendly tool that runs directly in your browser. It calculates attendance percentage, safe bunks, and recovery classes instantly without requiring app store downloads, logins, or server storage.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">What is a Student Attendance Calculator?</summary>
							<div class="faq-answer">
								<p>
									A <strong>student attendance calculator</strong> is a specialized educational calculator designed for school and university students to keep track of lecture and laboratory attendance. It prevents examination debarment by alerting students when attendance drops near or below mandatory thresholds like 75% or 80%.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">Can you use the Attendance Calculator for 100 Percent?</summary>
							<div class="faq-answer">
								<p>
									Yes, you can set the attendance target to <strong>100%</strong> using our custom target input. Note that achieving 100% attendance requires attending every single class held from day one. If even one class has been missed, reaching a 100.0% final attendance is mathematically impossible.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">How does the Attendance Calculator 80 percent target work?</summary>
							<div class="faq-answer">
								<p>
									The <strong>Attendance Calculator 80</strong> feature sets your target threshold to 80% (common in premier universities and professional degree courses). To maintain 80%, you must attend at least 4 out of every 5 classes held (Attended ≥ 0.8 × Total Classes).
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">How does the Attendance Calculator 75 percent target work?</summary>
							<div class="faq-answer">
								<p>
									The <strong>Attendance Calculator 75</strong> helps students satisfy the standard 75% attendance rule mandated by UGC and colleges. If your current attendance is ≥ 75%, it calculates how many classes you can skip. If it is &lt; 75%, it computes the exact number of consecutive classes you must attend to return to 75%.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">For a 75 percent attendance calculator, how many days can you miss?</summary>
							<div class="faq-answer">
								<p>
									For a standard semester with 100 classes, you need to attend at least 75 classes and can miss a maximum of 25 classes. If you have currently attended 30 out of 40 classes held, you can miss 0 immediate classes without dropping below 75%, but out of the remaining 60 semester classes, you can skip up to 15 classes.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">How to use an attendance percentage calculator?</summary>
							<div class="faq-answer">
								<p>
									To use an <strong>attendance percentage calculator</strong>: 1) Select your target attendance (e.g., 75% or 80%), 2) Enter the number of classes or days you attended, 3) Enter the total classes or days conducted so far. The calculator immediately shows your current percentage, status badge, and safe bunk quota.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">How is attendance percentage calculated?</summary>
							<div class="faq-answer">
								<p>
									Attendance percentage is calculated by dividing the total number of present sessions by the total number of delivered sessions, and multiplying that fraction by 100. For instance, attending 45 out of 60 lectures gives <code>(45 / 60) × 100 = 75%</code>.
								</p>
							</div>
						</details>

						<details class="faq-item">
							<summary class="faq-question">How to calculate attendance percentage with a calculator?</summary>
							<div class="faq-answer">
								<p>
									On any calculator: type your attended classes, press divide (÷), enter total classes held, press multiply (×), enter 100, and press equals (=). Or simply use our free online <strong>attendance calculator app</strong> to get instant calculations with bunk suggestions automatically.
								</p>
							</div>
						</details>
					</div>
				</section>
			</article>

			<!-- Simple Footer -->
			<footer class="footer text-center">
				<p class="footer-note">
					© {new Date().getFullYear()} Attendance 75 Calculator • Free Online College Attendance Tracker • Client-side math & 100% private
				</p>
			</footer>
		</div>
	</div>

	<!-- Toast Notification -->
	<div id="toast" class="toast hidden">
		✓ Copied status to clipboard!
	</div>
</Layout>

<style>
	/* CSS Variables for Light & Dark Theme */
	:root {
		--bg-canvas: #fafafa;
		--bg-card: #ffffff;
		--bg-input: #ffffff;
		--bg-subtle: #fafafa;
		--bg-pill: #ffffff;
		--bg-pill-hover: #f2f2f2;
		--bg-pill-active: #171717;
		--text-pill-active: #ffffff;
		--text-ink: #171717;
		--text-body: #4d4d4d;
		--text-muted: #8f8f8f;
		--border-hairline: #ebebeb;
		--border-focus: #171717;
		--track-bg: #f2f2f2;
		--target-marker-bg: #171717;
		--shadow-card: 0 2px 8px rgba(0,0,0,0.04);
		--badge-target-bg: #d3e5ff;
		--badge-target-text: #0070f3;

		/* Vibe Colors Light */
		--vibe-safe-bg: #f4fbf6;
		--vibe-safe-border: #c7eed2;
		--vibe-safe-text: #00703c;
		--vibe-warn-bg: #fffdf5;
		--vibe-warn-border: #fde8b3;
		--vibe-warn-text: #ab570a;
		--vibe-danger-bg: #fff8f8;
		--vibe-danger-border: #fcd5d5;
		--vibe-danger-text: #ee0000;
		--vibe-cooked-bg: #171717;
		--vibe-cooked-border: #000000;
		--vibe-cooked-text: #ffffff;

		/* SEO Article Light */
		--code-bg: #f3f3f3;
		--code-border: #e5e5e5;
	}

	html.dark {
		--bg-canvas: #0a0a0a;
		--bg-card: #121212;
		--bg-input: #1a1a1a;
		--bg-subtle: #171717;
		--bg-pill: #1a1a1a;
		--bg-pill-hover: #262626;
		--bg-pill-active: #ffffff;
		--text-pill-active: #000000;
		--text-ink: #ededed;
		--text-body: #a1a1a1;
		--text-muted: #707070;
		--border-hairline: #262626;
		--border-focus: #ffffff;
		--track-bg: #262626;
		--target-marker-bg: #ffffff;
		--shadow-card: 0 4px 20px rgba(0,0,0,0.3);
		--badge-target-bg: #072a5a;
		--badge-target-text: #52a8ff;

		/* Vibe Colors Dark */
		--vibe-safe-bg: #0b2214;
		--vibe-safe-border: #164e29;
		--vibe-safe-text: #4ade80;
		--vibe-warn-bg: #291a03;
		--vibe-warn-border: #593907;
		--vibe-warn-text: #fbbf24;
		--vibe-danger-bg: #2b0b0b;
		--vibe-danger-border: #5c1818;
		--vibe-danger-text: #f87171;
		--vibe-cooked-bg: #000000;
		--vibe-cooked-border: #404040;
		--vibe-cooked-text: #ffffff;

		/* SEO Article Dark */
		--code-bg: #1c1c1c;
		--code-border: #2a2a2a;
	}

	/* Layout & Base */
	.page-container {
		min-height: 100vh;
		background-color: var(--bg-canvas);
		color: var(--text-ink);
		display: flex;
		justify-content: center;
		padding: 28px 16px;
		font-family: 'Geist', Arial, sans-serif;
		box-sizing: border-box;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.content-wrapper {
		width: 100%;
		max-width: 640px;
		display: flex;
		flex-direction: column;
	}

	/* Top Nav Bar with Theme Toggle */
	.top-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20px;
	}

	.inline-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		font-size: 12px;
		font-weight: 500;
		color: var(--text-body);
		box-shadow: 0 1px 2px rgba(0,0,0,0.03);
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background-color: #00c851;
		border-radius: 50%;
	}

	/* Theme Toggle Button */
	.theme-toggle-btn {
		display: inline-flex;
