---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Attendance 75 Calculator | Bunk Budget & Semester Projection"
	description="Calculate how many classes you can safely bunk, what you need to recover, or check if you're cooked for the semester."
>
	<div class="page-container">
		<div class="content-wrapper">
			<!-- Top Bar with Brand Badge & Theme Toggle -->
			<nav class="top-nav">
				<div class="inline-badge">
					<span class="badge-dot"></span>
					<span class="badge-text">Attendance 75 Calculator</span>
				</div>

				<!-- Theme Toggle Button -->
				<button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Dark/Light Mode" title="Toggle Theme">
					<span id="theme-icon" class="theme-icon">🌙</span>
					<span id="theme-label" class="theme-label">Dark</span>
				</button>
			</nav>

			<!-- Header -->
			<header class="text-center mb-6">
				<h1 class="page-title">
					Attendance & Bunk Calculator
				</h1>
				<p class="page-subtitle">
					Know exactly how many classes you can skip, how many you gotta attend, or if you're cooked.
				</p>
			</header>

			<!-- Main Calculator Card -->
			<main class="calculator-card">
				<!-- 1. Target Percentage Selector -->
				<div class="form-group mb-5">
					<div class="flex-between mb-2">
						<label class="field-label">Target Attendance Requirement</label>
						<span class="target-indicator" id="target-indicator">Target: 75%</span>
					</div>
					<div class="pills-grid" id="target-pills">
						<button type="button" class="target-btn" data-value="60">60%</button>
						<button type="button" class="target-btn" data-value="65">65%</button>
						<button type="button" class="target-btn" data-value="70">70%</button>
						<button type="button" class="target-btn active" data-value="75">75%</button>
						<button type="button" class="target-btn" data-value="80">80%</button>
						<button type="button" class="target-btn" data-value="85">85%</button>
						<button type="button" class="target-btn" data-value="90">90%</button>
						<div class="custom-target-wrap">
							<input
								type="number"
								id="custom-target"
								min="1"
								max="100"
								placeholder="Custom"
								class="custom-target-input"
							/>
							<span class="custom-target-unit">%</span>
						</div>
					</div>
				</div>

				<!-- 2. Inputs Grid (Attended, Total Held, Total in Semester) -->
				<div class="inputs-grid mb-6">
					<div class="input-block">
						<label for="classes-attended" class="field-label">
							Classes Attended <span class="label-muted">(Present)</span>
						</label>
						<input
							type="number"
							id="classes-attended"
							min="0"
							value="30"
							placeholder="e.g. 30"
							class="text-input"
						/>
					</div>

					<div class="input-block">
						<label for="total-classes" class="field-label">
							Total Classes Held <span class="label-muted">(To Date)</span>
						</label>
						<input
							type="number"
							id="total-classes"
							min="0"
							value="40"
							placeholder="e.g. 40"
							class="text-input"
						/>
					</div>

					<div class="input-block full-width-sm">
						<label for="total-semester-classes" class="field-label">
							Total Classes in Semester <span class="label-optional">(Optional)</span>
						</label>
						<input
							type="number"
							id="total-semester-classes"
							min="0"
							value="100"
							placeholder="e.g. 100 expected classes"
							class="text-input"
						/>
					</div>
				</div>

				<!-- 3. Dynamic Results Box -->
				<div id="results-box" class="results-box">
					<!-- Header Status & Percentage -->
					<div class="results-header">
						<div>
							<span class="result-eyebrow">CURRENT ATTENDANCE</span>
							<div class="percentage-row">
								<span id="percentage-display" class="percentage-val">75.0%</span>
								<span id="ratio-display" class="ratio-val">(30 / 40 held)</span>
							</div>
						</div>
						<div id="status-badge" class="status-badge status-safe">
							Safe & Chilling
						</div>
					</div>

					<!-- Progress Bar with Target Marker -->
					<div class="progress-track">
						<div id="progress-bar" class="progress-fill" style="width: 75%;"></div>
						<div id="target-marker" class="target-marker" style="left: 75%;" title="Target: 75%"></div>
					</div>

					<!-- Vibe Check / Primary Slang Message Box -->
					<div id="vibe-box" class="vibe-box vibe-safe">
						<p id="vibe-message" class="vibe-message">
							You're safe to bunk! Go touch grass, grab some chai, and enjoy your free time. 🚀
						</p>
					</div>

					<!-- Split Details: Right Now vs. End-of-Semester -->
					<div class="details-grid">
						<!-- Immediate To-Date Card -->
						<div class="detail-card">
							<span class="detail-eyebrow">RIGHT NOW STATUS</span>
							<h3 id="current-headline" class="detail-headline">Safe to Bunk: 0 classes</h3>
							<p id="current-desc" class="detail-desc">
								You are exactly at 75%. Cannot miss any immediate classes without dropping.
							</p>
						</div>

						<!-- End of Semester Forecast Card -->
						<div id="sem-forecast-card" class="detail-card">
							<span class="detail-eyebrow">SEMESTER FORECAST</span>
							<h3 id="sem-headline" class="detail-headline">Semester Bunk Budget: 15 classes</h3>
							<p id="sem-desc" class="detail-desc">
								Out of 60 classes left, you only need to attend 45 to finish at 75%.
							</p>
						</div>
					</div>

					<!-- Quick Copy Status Button -->
					<div class="mt-4">
						<button type="button" id="copy-summary-btn" class="btn-copy">
							<span id="copy-icon">📋</span>
							<span id="copy-btn-text">Copy Attendance Vibe Check</span>
						</button>
					</div>
				</div>
			</main>

			<!-- Simple Footer -->
			<footer class="footer text-center">
				<p class="footer-note">
					Client-side math • 100% private • No login required
				</p>
			</footer>
		</div>
	</div>

	<!-- Toast Notification -->
	<div id="toast" class="toast hidden">
		✓ Copied status to clipboard!
	</div>
</Layout>

<style>
	/* CSS Variables for Light & Dark Theme */
	:root {
		--bg-canvas: #fafafa;
		--bg-card: #ffffff;
		--bg-input: #ffffff;
		--bg-subtle: #fafafa;
		--bg-pill: #ffffff;
		--bg-pill-hover: #f2f2f2;
		--bg-pill-active: #171717;
		--text-pill-active: #ffffff;
		--text-ink: #171717;
		--text-body: #4d4d4d;
		--text-muted: #8f8f8f;
		--border-hairline: #ebebeb;
		--border-focus: #171717;
		--track-bg: #f2f2f2;
		--target-marker-bg: #171717;
		--shadow-card: 0 2px 8px rgba(0,0,0,0.04);
		--badge-target-bg: #d3e5ff;
		--badge-target-text: #0070f3;

		/* Vibe Colors Light */
		--vibe-safe-bg: #f4fbf6;
		--vibe-safe-border: #c7eed2;
		--vibe-safe-text: #00703c;
		--vibe-warn-bg: #fffdf5;
		--vibe-warn-border: #fde8b3;
		--vibe-warn-text: #ab570a;
		--vibe-danger-bg: #fff8f8;
		--vibe-danger-border: #fcd5d5;
		--vibe-danger-text: #ee0000;
		--vibe-cooked-bg: #171717;
		--vibe-cooked-border: #000000;
		--vibe-cooked-text: #ffffff;
	}

	html.dark {
		--bg-canvas: #0a0a0a;
		--bg-card: #121212;
		--bg-input: #1a1a1a;
		--bg-subtle: #171717;
		--bg-pill: #1a1a1a;
		--bg-pill-hover: #262626;
		--bg-pill-active: #ffffff;
		--text-pill-active: #000000;
		--text-ink: #ededed;
		--text-body: #a1a1a1;
		--text-muted: #707070;
		--border-hairline: #262626;
		--border-focus: #ffffff;
		--track-bg: #262626;
		--target-marker-bg: #ffffff;
		--shadow-card: 0 4px 20px rgba(0,0,0,0.3);
		--badge-target-bg: #072a5a;
		--badge-target-text: #52a8ff;

		/* Vibe Colors Dark */
		--vibe-safe-bg: #0b2214;
		--vibe-safe-border: #164e29;
		--vibe-safe-text: #4ade80;
		--vibe-warn-bg: #291a03;
		--vibe-warn-border: #593907;
		--vibe-warn-text: #fbbf24;
		--vibe-danger-bg: #2b0b0b;
		--vibe-danger-border: #5c1818;
		--vibe-danger-text: #f87171;
		--vibe-cooked-bg: #000000;
		--vibe-cooked-border: #404040;
		--vibe-cooked-text: #ffffff;
	}

	/* Layout & Base */
	.page-container {
		min-height: 100vh;
		background-color: var(--bg-canvas);
		color: var(--text-ink);
		display: flex;
		justify-content: center;
		padding: 28px 16px;
		font-family: 'Geist', Arial, sans-serif;
		box-sizing: border-box;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.content-wrapper {
		width: 100%;
		max-width: 620px;
		display: flex;
		flex-direction: column;
	}

	/* Top Nav Bar with Theme Toggle */
	.top-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20px;
	}

	.inline-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		font-size: 12px;
		font-weight: 500;
		color: var(--text-body);
		box-shadow: 0 1px 2px rgba(0,0,0,0.03);
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background-color: #00c851;
		border-radius: 50%;
	}

	/* Theme Toggle Button */
	.theme-toggle-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		font-size: 12px;
		font-weight: 500;
		color: var(--text-ink);
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}

	.theme-toggle-btn:hover {
		background: var(--bg-pill-hover);
		border-color: var(--text-muted);
	}

	.theme-icon {
		font-size: 14px;
		line-height: 1;
	}

	.theme-label {
		font-size: 12px;
		font-weight: 500;
	}

	/* Header */
	.page-title {
		font-size: 30px;
		font-weight: 700;
		color: var(--text-ink);
		margin: 6px 0;
		letter-spacing: -0.8px;
		line-height: 1.2;
	}

	.page-subtitle {
		font-size: 14px;
		color: var(--text-body);
		line-height: 1.5;
		margin: 0 auto;
		max-width: 480px;
	}

	/* Card */
	.calculator-card {
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 16px;
		padding: 28px;
		box-shadow: var(--shadow-card);
		margin-bottom: 20px;
		transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.field-label {
		display: block;
		font-size: 13px;
		font-weight: 600;
		color: var(--text-ink);
		margin-bottom: 6px;
	}

	.label-muted {
		font-weight: 400;
		color: var(--text-muted);
		font-size: 11px;
	}

	.label-optional {
		font-weight: 500;
		color: var(--badge-target-text);
		font-size: 11px;
	}

	.flex-between {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.target-indicator {
		font-size: 12px;
		font-weight: 600;
		color: var(--badge-target-text);
		background: var(--badge-target-bg);
		padding: 2px 8px;
		border-radius: 100px;
	}

	/* Target Pills Grid */
	.pills-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		align-items: center;
	}

	.target-btn {
		padding: 7px 14px;
		font-size: 13px;
		font-weight: 500;
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		background: var(--bg-pill);
		color: var(--text-body);
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}

	.target-btn:hover {
		background: var(--bg-pill-hover);
		color: var(--text-ink);
	}

	.target-btn.active {
		background: var(--bg-pill-active);
		color: var(--text-pill-active);
		border-color: var(--bg-pill-active);
		font-weight: 600;
	}

	.custom-target-wrap {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		background: var(--bg-input);
		border: 1px solid var(--border-hairline);
		border-radius: 100px;
		padding: 2px 10px;
	}

	.custom-target-input {
		width: 50px;
		border: none;
		outline: none;
		font-size: 13px;
		font-family: inherit;
		color: var(--text-ink);
		background: transparent;
		text-align: center;
		padding: 3px 0;
	}

	.custom-target-unit {
		font-size: 12px;
		color: var(--text-muted);
		font-weight: 500;
	}

	/* Inputs Grid */
	.inputs-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}

	.full-width-sm {
		grid-column: 1 / -1;
	}

	.input-block {
		display: flex;
		flex-direction: column;
	}

	.text-input {
		width: 100%;
		padding: 11px 14px;
		font-size: 15px;
		border: 1px solid var(--border-hairline);
		border-radius: 8px;
		font-family: inherit;
		color: var(--text-ink);
		background: var(--bg-input);
		box-sizing: border-box;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.2s ease;
	}

	.text-input:focus {
		outline: none;
		border-color: var(--border-focus);
		box-shadow: 0 0 0 1px var(--border-focus);
	}

	/* Results Box */
	.results-box {
		border-top: 1px solid var(--border-hairline);
		padding-top: 24px;
	}

	.results-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 14px;
	}

	.result-eyebrow {
		font-size: 11px;
		font-weight: 600;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.percentage-row {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin-top: 2px;
	}

	.percentage-val {
		font-size: 34px;
		font-weight: 700;
		color: var(--text-ink);
		letter-spacing: -1px;
		line-height: 1;
	}

	.ratio-val {
		font-size: 13px;
		color: var(--text-muted);
	}

	.status-badge {
		padding: 5px 12px;
		border-radius: 100px;
		font-size: 12px;
		font-weight: 600;
	}

	.status-safe {
		background: #d4f4dd;
		color: #00703c;
	}

	html.dark .status-safe {
		background: #0e371a;
		color: #4ade80;
	}

	.status-warning {
		background: #ffefcf;
		color: #ab570a;
	}

	html.dark .status-warning {
		background: #3b2803;
		color: #fcd34d;
	}

	.status-danger {
		background: #ffebeb;
		color: #ee0000;
	}

	html.dark .status-danger {
		background: #3b0f0f;
		color: #f87171;
	}

	.status-cooked {
		background: #171717;
		color: #ffffff;
		border: 1px solid #404040;
	}

	html.dark .status-cooked {
		background: #ffffff;
		color: #000000;
		border: 1px solid #ffffff;
	}

	/* Progress Track */
	.progress-track {
		position: relative;
		height: 8px;
		background: var(--track-bg);
		border-radius: 100px;
		margin-bottom: 18px;
		overflow: visible;
	}

	.progress-fill {
		height: 100%;
		border-radius: 100px;
		transition: width 0.3s ease, background-color 0.3s ease;
		background-color: #00c851;
	}

	.target-marker {
		position: absolute;
		top: -3px;
		bottom: -3px;
		width: 3px;
		background: var(--target-marker-bg);
		border-radius: 2px;
		transform: translateX(-50%);
		z-index: 2;
	}

	/* Vibe Box */
	.vibe-box {
		padding: 14px 18px;
		border-radius: 10px;
		margin-bottom: 16px;
		border: 1px solid transparent;
		transition: all 0.2s ease;
	}

	.vibe-safe {
		background: var(--vibe-safe-bg);
		border-color: var(--vibe-safe-border);
		color: var(--vibe-safe-text);
	}

	.vibe-warning {
		background: var(--vibe-warn-bg);
		border-color: var(--vibe-warn-border);
		color: var(--vibe-warn-text);
	}

	.vibe-danger {
		background: var(--vibe-danger-bg);
		border-color: var(--vibe-danger-border);
		color: var(--vibe-danger-text);
	}

	.vibe-cooked {
		background: var(--vibe-cooked-bg);
		color: var(--vibe-cooked-text);
		border-color: var(--vibe-cooked-border);
	}

	.vibe-message {
		font-size: 14px;
		font-weight: 500;
		line-height: 1.5;
		margin: 0;
	}

	/* Details Grid */
	.details-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}

	.detail-card {
		background: var(--bg-subtle);
		border: 1px solid var(--border-hairline);
		border-radius: 10px;
		padding: 14px;
		display: flex;
		flex-direction: column;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.detail-eyebrow {
		font-size: 10px;
		font-weight: 600;
		color: var(--text-muted);
		letter-spacing: 0.5px;
		text-transform: uppercase;
		margin-bottom: 4px;
	}

	.detail-headline {
		font-size: 14px;
		font-weight: 700;
		color: var(--text-ink);
		margin: 0 0 4px 0;
		line-height: 1.3;
	}

	.detail-desc {
		font-size: 12px;
		color: var(--text-body);
		line-height: 1.4;
		margin: 0;
	}

	/* Copy Button */
	.btn-copy {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 11px 16px;
		background: var(--bg-card);
		border: 1px solid var(--border-hairline);
		border-radius: 8px;
		font-size: 13px;
		font-weight: 600;
		color: var(--text-ink);
		cursor: pointer;
		transition: all 0.15s ease;
		font-family: inherit;
	}

	.btn-copy:hover {
		background: var(--bg-pill-hover);
		border-color: var(--border-focus);
	}

	/* Footer Note */
	.footer-note {
		font-size: 12px;
		color: var(--text-muted);
		margin: 0;
	}

	/* Toast */
	.toast {
		position: fixed;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--text-ink);
		color: var(--bg-canvas);
		padding: 10px 20px;
		border-radius: 100px;
		font-size: 13px;
		font-weight: 500;
		box-shadow: 0 4px 16px rgba(0,0,0,0.25);
		z-index: 100;
	}

	.hidden {
		display: none !important;
	}

	/* Mobile responsive */
	@media (max-width: 540px) {
		.calculator-card {
			padding: 20px 16px;
		}

		.inputs-grid {
			grid-template-columns: 1fr;
		}

		.details-grid {
			grid-template-columns: 1fr;
		}

		.percentage-val {
			font-size: 28px;
		}
	}
</style>

<script>
	// --- THEME TOGGLE LOGIC ---
	const themeToggleBtn = document.getElementById('theme-toggle');
	const themeIcon = document.getElementById('theme-icon');
	const themeLabel = document.getElementById('theme-label');

	function updateThemeUI(isDark: boolean) {
		if (themeIcon && themeLabel) {
			if (isDark) {
				themeIcon.textContent = '☀️';
				themeLabel.textContent = 'Light';
			} else {
				themeIcon.textContent = '🌙';
				themeLabel.textContent = 'Dark';
			}
		}
	}

	// Initialize button state based on current html class
	const isInitiallyDark = document.documentElement.classList.contains('dark');
	updateThemeUI(isInitiallyDark);

	themeToggleBtn?.addEventListener('click', () => {
		const isCurrentlyDark = document.documentElement.classList.contains('dark');
		const newThemeIsDark = !isCurrentlyDark;

		if (newThemeIsDark) {
			document.documentElement.classList.add('dark');
			localStorage.setItem('theme', 'dark');
		} else {
			document.documentElement.classList.remove('dark');
			localStorage.setItem('theme', 'light');
		}

		updateThemeUI(newThemeIsDark);
	});

	// --- ATTENDANCE CALCULATOR LOGIC ---
	let targetPercentage = 75;

	// Elements
	const attendedInput = document.getElementById('classes-attended') as HTMLInputElement;
	const totalInput = document.getElementById('total-classes') as HTMLInputElement;
	const semTotalInput = document.getElementById('total-semester-classes') as HTMLInputElement;
	const customTargetInput = document.getElementById('custom-target') as HTMLInputElement;

	const targetButtons = document.querySelectorAll('.target-btn');
	const targetIndicator = document.getElementById('target-indicator');
	const targetMarker = document.getElementById('target-marker');

	const percentageDisplay = document.getElementById('percentage-display');
	const ratioDisplay = document.getElementById('ratio-display');
	const statusBadge = document.getElementById('status-badge');
	const progressBar = document.getElementById('progress-bar');
	const vibeBox = document.getElementById('vibe-box');
	const vibeMessage = document.getElementById('vibe-message');

	const currentHeadline = document.getElementById('current-headline');
	const currentDesc = document.getElementById('current-desc');
	const semForecastCard = document.getElementById('sem-forecast-card');
	const semHeadline = document.getElementById('sem-headline');
	const semDesc = document.getElementById('sem-desc');

	const copySummaryBtn = document.getElementById('copy-summary-btn');
	const toast = document.getElementById('toast');

	function calculate() {
		const attended = parseFloat(attendedInput?.value) || 0;
		const totalHeld = parseFloat(totalInput?.value) || 0;
		const target = targetPercentage;
		const targetFrac = target / 100;

		const semTotalRaw = parseFloat(semTotalInput?.value);
		const hasSemTotal = !isNaN(semTotalRaw) && semTotalRaw > totalHeld;
		const semTotal = hasSemTotal ? semTotalRaw : totalHeld;

		if (targetIndicator) targetIndicator.textContent = `Target: ${target}%`;
		if (targetMarker) {
			targetMarker.style.left = `${Math.min(target, 100)}%`;
			targetMarker.title = `Target: ${target}%`;
		}

		// Validation: Total = 0
		if (totalHeld === 0) {
			if (percentageDisplay) percentageDisplay.textContent = '0.0%';
			if (ratioDisplay) ratioDisplay.textContent = '(0 / 0 held)';
			if (progressBar) progressBar.style.width = '0%';
			if (statusBadge) {
				statusBadge.textContent = 'No Data';
				statusBadge.className = 'status-badge status-warning';
			}
			if (vibeBox && vibeMessage) {
				vibeBox.className = 'vibe-box vibe-warning';
				vibeMessage.textContent = 'Enter your attended and total classes to calculate your status.';
			}
			if (currentHeadline) currentHeadline.textContent = 'Waiting for input...';
			if (currentDesc) currentDesc.textContent = 'Enter numbers above to see your bunk budget.';
			if (semForecastCard) semForecastCard.classList.add('hidden');
			return;
		}

		// Validation: Attended > Total
		if (attended > totalHeld) {
			if (statusBadge) {
				statusBadge.textContent = 'Invalid Input';
				statusBadge.className = 'status-badge status-danger';
			}
			if (vibeBox && vibeMessage) {
				vibeBox.className = 'vibe-box vibe-danger';
				vibeMessage.textContent = 'Attended classes cannot be higher than total classes held! Check your numbers.';
			}
			if (currentHeadline) currentHeadline.textContent = 'Input Error';
			if (currentDesc) currentDesc.textContent = 'Please fix your attended count.';
			return;
		}

		const currentPercentage = (attended / totalHeld) * 100;
		if (percentageDisplay) percentageDisplay.textContent = `${currentPercentage.toFixed(1)}%`;
		if (ratioDisplay) ratioDisplay.textContent = `(${attended} / ${totalHeld} held)`;

		// Update Progress Bar
		if (progressBar) {
			progressBar.style.width = `${Math.min(currentPercentage, 100)}%`;
			if (currentPercentage >= target) {
				progressBar.style.backgroundColor = '#00c851';
			} else if (currentPercentage >= target - 5) {
				progressBar.style.backgroundColor = '#f5a623';
			} else {
				progressBar.style.backgroundColor = '#ee0000';
			}
		}

		// --- RIGHT NOW CALCULATION ---
		let immediateBunks = 0;
		let immediateAttend = 0;
		if (currentPercentage >= target) {
			immediateBunks = Math.floor((attended / targetFrac) - totalHeld);
			if (currentHeadline) {
				currentHeadline.textContent = immediateBunks > 0
					? `Safe to Bunk: ${immediateBunks} class${immediateBunks > 1 ? 'es' : ''}`
					: 'Bunk Buffer: 0 classes';
			}
			if (currentDesc) {
				currentDesc.textContent = immediateBunks > 0
					? `You can miss the next ${immediateBunks} class${immediateBunks > 1 ? 'es' : ''} in a row without dropping below ${target}%.`
					: `You are on the line (${currentPercentage.toFixed(1)}%). Missing the next class will drop you below ${target}%.`;
			}
		} else {
			if (targetFrac === 1) {
				immediateAttend = 0;
				if (currentHeadline) currentHeadline.textContent = '100% Target Impossible';
				if (currentDesc) currentDesc.textContent = 'Once a class is missed, 100% cannot be regained.';
			} else {
				immediateAttend = Math.ceil(((targetFrac * totalHeld) - attended) / (1 - targetFrac));
				if (currentHeadline) currentHeadline.textContent = `Attend Next: ${immediateAttend} class${immediateAttend > 1 ? 'es' : ''}`;
				if (currentDesc) currentDesc.textContent = `Attend ${immediateAttend} consecutive classes without missing to climb back to ${target}%.`;
			}
		}

		// --- END OF SEMESTER PROJECTION CALCULATION ---
		const remaining = Math.max(0, semTotal - totalHeld);
		const maxPossibleAttended = attended + remaining;
		const maxPossiblePct = semTotal > 0 ? (maxPossibleAttended / semTotal) * 100 : currentPercentage;
		const semTotalTargetAttended = Math.ceil(targetFrac * semTotal);
		const semNeededFromRemaining = Math.max(0, semTotalTargetAttended - attended);
		const semBunksRemaining = remaining - semNeededFromRemaining;

		const isCooked = hasSemTotal && maxPossiblePct < target;

		if (hasSemTotal && semForecastCard && semHeadline && semDesc) {
			semForecastCard.classList.remove('hidden');

			if (isCooked) {
				semHeadline.textContent = '💀 Term Outlook: Cooked';
				semDesc.textContent = `Even with 100% attendance in all ${remaining} remaining classes, max achievable is only ${maxPossiblePct.toFixed(1)}%.`;
			} else if (semBunksRemaining > 0) {
				semHeadline.textContent = `Semester Bunk Budget: ${semBunksRemaining} classes`;
				semDesc.textContent = `Out of ${remaining} remaining classes, you only need to attend ${semNeededFromRemaining} to finish above ${target}%.`;
			} else {
				semHeadline.textContent = `Must Attend: ${semNeededFromRemaining} / ${remaining} classes`;
				semDesc.textContent = `You must attend at least ${semNeededFromRemaining} of the ${remaining} remaining classes to hit ${target}%.`;
			}
		} else if (semForecastCard) {
			semForecastCard.classList.add('hidden');
		}

		// --- STUDENT SLANG VIBE MESSAGING ---
		if (vibeBox && vibeMessage && statusBadge) {
			if (isCooked) {
				// COOKED STATE
				vibeBox.className = 'vibe-box vibe-cooked';
				statusBadge.textContent = 'Cooked 💀';
				statusBadge.className = 'status-badge status-cooked';
				vibeMessage.innerHTML = `<strong>You're cooked bro.</strong> Mathematically impossible to save this attendance even if you sit through every single remaining class (Max: ${maxPossiblePct.toFixed(1)}%). RIP. 💀`;
			} else if (currentPercentage >= target) {
				// SAFE STATE
				vibeBox.className = 'vibe-box vibe-safe';
				statusBadge.textContent = 'Safe & Chilling 🚀';
				statusBadge.className = 'status-badge status-safe';
				if (immediateBunks > 0) {
					vibeMessage.innerHTML = `You're safe to bunk! Go touch grass, grab some chai, and enjoy your free time. <strong>${immediateBunks} safe bunk${immediateBunks > 1 ? 's' : ''} available.</strong> 🚀`;
				} else {
					vibeMessage.innerHTML = `You're safely at <strong>${currentPercentage.toFixed(1)}%</strong>, but on the edge! Don't bunk today or you'll drop below ${target}%. ⚠️`;
				}
			} else if (currentPercentage >= target - 5) {
				// BORDERLINE STATE
				vibeBox.className = 'vibe-box vibe-warning';
				statusBadge.textContent = 'Borderline ⚠️';
				statusBadge.className = 'status-badge status-warning';
				vibeMessage.innerHTML = `Walking on thin ice bro. <strong>Time to wake up and head to class!</strong> Attend the next <strong>${immediateAttend} class${immediateAttend > 1 ? 'es' : ''}</strong> to fix this. ☕`;
			} else {
				// SHORTAGE RECOVERABLE STATE
				vibeBox.className = 'vibe-box vibe-danger';
				statusBadge.textContent = 'Shortage 🚨';
				statusBadge.className = 'status-badge status-danger';
				vibeMessage.innerHTML = `Time to wake up and head to class. <strong>You can still fix this if you grind now!</strong> Attend the next <strong>${immediateAttend} classes</strong> consecutively. 📚`;
			}
		}
	}

	// Target percentage button clicks
	targetButtons.forEach(btn => {
		btn.addEventListener('click', () => {
			targetButtons.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			targetPercentage = parseInt(btn.getAttribute('data-value') || '75');
			if (customTargetInput) customTargetInput.value = '';
			calculate();
		});
	});

	// Custom target input
	customTargetInput?.addEventListener('input', () => {
		const val = parseFloat(customTargetInput.value);
		if (!isNaN(val) && val > 0 && val <= 100) {
			targetButtons.forEach(b => b.classList.remove('active'));
			targetPercentage = val;
			calculate();
		}
	});

	// Copy Summary Button
	copySummaryBtn?.addEventListener('click', () => {
		const attended = parseFloat(attendedInput?.value) || 0;
		const totalHeld = parseFloat(totalInput?.value) || 0;
		const pct = totalHeld > 0 ? ((attended / totalHeld) * 100).toFixed(1) : '0';
		const statusText = statusBadge?.textContent || 'Attendance Update';
		const msgText = vibeMessage?.textContent || '';

		const textSummary =
`📊 Attendance Vibe Check
• Status: ${statusText}
• Attendance: ${pct}% (${attended}/${totalHeld} classes)
• Target: ${targetPercentage}%
• Note: ${msgText}
Calculated on attendance75calculator.com`;

		navigator.clipboard.writeText(textSummary).then(() => {
			if (toast) {
				toast.classList.remove('hidden');
				setTimeout(() => {
					toast.classList.add('hidden');
				}, 2200);
			}
		}).catch(() => {
			alert('Failed to copy to clipboard.');
		});
	});

	// Event listeners
	attendedInput?.addEventListener('input', calculate);
	totalInput?.addEventListener('input', calculate);
	semTotalInput?.addEventListener('input', calculate);

	// Initial run
	calculate();
</script>
